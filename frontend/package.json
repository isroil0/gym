{
  "name": "gym-crm-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "description": "Gym CRM web client",
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "i18n:check": "vitest run src/i18n/__tests__",
    "api:types": "openapi-typescript ../openapi.json -o src/lib/api/schema.d.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-charts": "^8.29.3",
    "@mui/x-data-grid": "^8.29.3",
    "@mui/x-date-pickers": "^8.29.3",
    "@tanstack/react-query": "^5.104.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "date-fns": "^4.1.0",
    "motion": "^12.43.0",
    "next": "^15.5.27",
    "next-intl": "^4.14.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.65.1",
    "react-qr-code": "^2.0.21",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "intl-messageformat": "^12.1.2",
    "jsdom": "^28.0.1",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@swc/core@1.16.13": false,
    "@parcel/watcher@2.6.0": false
  }
}
