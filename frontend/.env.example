# ---- Backend API ----
# Where the NestJS API is reachable from the Next.js server.
API_URL=http://localhost:3000
# Same address as the browser would see it. Only used as a fallback for API_URL
# and for display on the settings page.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Abort a backend call that takes longer than this, in milliseconds.
API_TIMEOUT_MS=20000

# ---- Display ----
# The gym's wall clock. Timestamps are rendered in this zone.
NEXT_PUBLIC_TIMEZONE=Asia/Tashkent
# The currency amounts are shown in. The backend stores money as plain decimal
# strings and does not record a currency, so this is a display choice.
NEXT_PUBLIC_CURRENCY=UZS
NEXT_PUBLIC_CURRENCY_DECIMALS=2

# ---- Cookies ----
# Set to true only when deliberately serving the app over plain http in an
# environment that is not production.
COOKIE_INSECURE=false
