NODE_ENV=test
PORT=3001
API_PREFIX=api
API_DEFAULT_VERSION=1
DATABASE_URL=postgresql://gym:gym@localhost:55433/gym_test?schema=public
LOG_LEVEL=error
LOG_PRETTY=false
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
CORS_ORIGINS=*
SEED_GYM_NAME=Gym CRM Test

# ---- Health ----
# Raised: Jest runs the whole e2e suite in one process and accumulates heap,
# which would otherwise trip the health indicator part-way through the run.
HEALTH_MEMORY_HEAP_MB=4096

# ---- Authentication ----
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=test-only-jwt-secret-value-not-for-production-use
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=gym-crm
JWT_AUDIENCE=gym-crm-api
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
# bcrypt cost factor (12 in production, lower only for tests)
BCRYPT_ROUNDS=4
SEED_ADMIN_EMAIL=admin@gym.test
SEED_ADMIN_PASSWORD=TestAdmin123!

# ---- Security ----
# Requests per IP per window for ordinary endpoints
RATE_LIMIT_MAX=100000
RATE_LIMIT_WINDOW_SECONDS=60
# Much tighter for credential endpoints (login, refresh, password reset)
AUTH_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Log any database query slower than this, in milliseconds. 0 disables.
SLOW_QUERY_MS=0

# ---- QR membership cards ----
# Signs QR card payloads. Must be at least 32 characters, and distinct from
# JWT_SECRET so the two have separate blast radii. Rotating it invalidates
# every card already issued.
QR_SECRET=test-only-qr-secret-value-not-for-production-use
