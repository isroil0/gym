# ---- Application ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_DEFAULT_VERSION=1

# ---- Database ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://gym:gym@localhost:55433/gym_dev?schema=public

# ---- Logging ----
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
LOG_PRETTY=true

# ---- Swagger ----
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ---- CORS ----
# Comma separated list of origins, or * for all
CORS_ORIGINS=*

# ---- Health ----
# Heap ceiling for the /health memory indicator, in MB
HEALTH_MEMORY_HEAP_MB=512

# ---- Authentication ----
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=gym-crm
JWT_AUDIENCE=gym-crm-api
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
# bcrypt cost factor (12 in production, lower only for tests)
BCRYPT_ROUNDS=12

# ---- Security ----
# Requests per IP per window for ordinary endpoints
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# Much tighter for credential endpoints (login, refresh, password reset)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Log any database query slower than this, in milliseconds. 0 disables.
SLOW_QUERY_MS=300

# ---- QR membership cards ----
# Signs QR card payloads. Must be at least 32 characters, and distinct from
# JWT_SECRET so the two have separate blast radii. Rotating it invalidates
# every card already issued.
QR_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# ---- Seed ----
SEED_GYM_NAME=Gym CRM
SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=ChangeMe123!
